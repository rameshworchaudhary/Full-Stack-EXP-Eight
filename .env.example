# Local configuration template for Kafka Reliability Lab
# Copy this file to .env before starting services: cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_DB=kafka_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kafka_lab
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Apache Kafka Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Retry & Simulation Tuning
APP_RETRY_MAX_ATTEMPTS=4
APP_RETRY_INITIAL_INTERVAL_MS=1000
APP_RETRY_MULTIPLIER=2.0
APP_RETRY_MAX_INTERVAL_MS=10000
APP_SIMULATOR_TRANSIENT_FAIL_COUNT=2
